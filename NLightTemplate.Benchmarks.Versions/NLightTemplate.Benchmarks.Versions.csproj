<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" Version="0.14.0" />
    <!-- Baseline reference so the benchmark compiles; BenchmarkDotNet swaps this for each version under
         test at run time (see Program.cs / NLT_VERSIONS). Keep this at the OLDEST version being compared so
         every swap is an upgrade-or-equal: a downgrade trips NuGet's NU1605 and the version fails to build. -->
    <PackageReference Include="NLightTemplate" Version="1.1.0" />
  </ItemGroup>

</Project>

<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" Version="0.15.8" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="[8.*,9)" />
    <!-- Baseline reference so the benchmark compiles; BenchmarkDotNet swaps this for each version under
         test at run time (see Program.cs / NLT_VERSIONS). [1.1.0] is an exact pin at the OLDEST version being
         compared so it never floats; keep it as the oldest, since a downgrade would trip NuGet's NU1605. -->
    <PackageReference Include="NLightTemplate" Version="[1.1.0]" />
  </ItemGroup>

</Project>
